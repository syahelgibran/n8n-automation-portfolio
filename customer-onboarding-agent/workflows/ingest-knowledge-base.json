    {
      "parameters": {
        "jsCode": "// Merangkum hasil uji pencarian supaya ketahuan RAG-nya sudah hidup atau belum.\nconst potongan = $input.all().map(function (i) { return i.json; });\n\nif (potongan.length === 0) {\n  throw new Error(\"Pencarian tidak mengembalikan apa pun. Cek: tabel warungos_kb kosong, atau nama fungsi match_warungos_kb salah di opsi node.\");\n}\n\nconst ringkas = potongan.map(function (p, idx) {\n  const teks = String(p.pageContent || p.document || \"\").replace(/\\s+/g, \" \").trim();\n  const meta = p.metadata || {};\n  return {\n    peringkat: idx + 1,\n    skor_kemiripan: p.score !== undefined ? Number(p.score).toFixed(4) : \"-\",\n    halaman: meta.loc && meta.loc.pageNumber ? meta.loc.pageNumber : (meta.page_number || \"-\"),\n    sumber: meta.sumber || \"-\",\n    cuplikan: teks.slice(0, 220) + (teks.length > 220 ? \"...\" : \"\")\n  };\n});\n\nreturn [{ json: {\n  status: \"RAG SIAP\",\n  jumlah_potongan_ditemukan: potongan.length,\n  pertanyaan_uji: \"Berapa lama proses verifikasi QRIS dan apa yang bisa dipakai sambil menunggu?\",\n  hasil: ringkas\n} }];"
      },
